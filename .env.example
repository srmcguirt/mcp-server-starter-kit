# MCP Server Starter Kit — Environment Variables
# Copy this to .env and fill in your values

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info   # error | warn | info | debug

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=60    # Max requests per window
RATE_LIMIT_WINDOW_MS=60000    # Window size in milliseconds (60000 = 1 minute)

# ─── Your API Keys (add your own) ────────────────────────────────────────────
# MY_API_KEY=your-api-key-here
# MY_API_BASE_URL=https://api.example.com
